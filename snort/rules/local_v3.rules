# ─────────────────────────────────────────────────────────────────────────
# [공격 유형 1-A] SQL Injection 탐지 - 따옴표 기반 (GET /api/account)
#   OWASP A03:2021 - Injection
#   v3 개선: 따옴표 뒤 괄호/공백/세미콜론 허용 → ') OR 패턴 탐지
#            키워드 확장 유지 (EXEC,HAVING,WAITFOR,SLEEP 등)
# ─────────────────────────────────────────────────────────────────────────
alert tcp any any -> any 5000 (msg:"[ATTACK] SQL Injection - Quote Based"; \
    http_uri; content:"/api/account", nocase; \
    pcre:"/(\'|\"|%27|%22)[\s\x3b\)\(]*(OR|AND|UNION|SELECT|DROP|INSERT|EXEC|HAVING|GROUP|WAITFOR|INTO|SHUTDOWN|BENCHMARK|EXTRACTVALUE|UPDATEXML|SLEEP|LOAD_FILE|OUTFILE|CONCAT)/i"; \
    sid:1000001; rev:7;)

# ─────────────────────────────────────────────────────────────────────────
# [공격 유형 1-B] SQL Injection 탐지 - 숫자형/코멘트 기반 (GET /api/account)
#   OWASP A03:2021 - Injection
#   v3 신규: 따옴표 없는 숫자형 injection (1 OR 1=1, 1; SELECT 등)
#            따옴표+코멘트만 있는 패턴 (admin'--, ' OR 1=1#)
# ─────────────────────────────────────────────────────────────────────────
alert tcp any any -> any 5000 (msg:"[ATTACK] SQL Injection - Numeric/Comment Based"; \
    http_uri; content:"/api/account", nocase; \
    pcre:"/(\d[\s\x3b]+(OR|AND|UNION|SELECT|DROP|INSERT)\b|'[\s]*(\-\-|#))/i"; \
    sid:1000005; rev:1;)

# ─────────────────────────────────────────────────────────────────────────
# [공격 유형 2] 비정상 고액 이체 탐지 (POST /api/transfer)
#   OWASP A04:2021 - Insecure Design
#   유지: 5억 이상 + 10억 이상 모두 탐지 (v2와 동일, 이미 100%)
# ─────────────────────────────────────────────────────────────────────────
alert tcp any any -> any 5000 (msg:"[CRITICAL] High Amount Transfer Attempt"; \
    http_method; content:"POST"; \
    http_uri; content:"/api/transfer", nocase; \
    http_client_body; pcre:"/\"amount\"\s*:\s*([5-9][0-9]{8}|[0-9]{10,})/"; \
    sid:1000002; rev:7;)

# ─────────────────────────────────────────────────────────────────────────
# [공격 유형 3] Brute Force / Flooding 탐지 (POST /api/transfer)
#   OWASP A07:2021 - Identification and Authentication Failures
#   유지: detection_filter 임계값 방식 (10초 내 30회 초과 시 탐지)
# ─────────────────────────────────────────────────────────────────────────
alert tcp any any -> any 5000 (msg:"[ATTACK] API Request Brute Force Detected"; \
    http_method; content:"POST"; \
    http_uri; content:"/api/transfer", nocase; \
    detection_filter: track by_src, count 30, seconds 10; \
    sid:1000003; rev:7;)

# ─────────────────────────────────────────────────────────────────────────
# [공격 유형 4] 의심 User-Agent / 스캐너 탐지
#   OWASP A09:2021 - Security Logging and Monitoring Failures
#   v3 개선: 실제 UA 문자열 기반 매칭 보강
#     - ffuf → "Fuzz Faster U Fool" 추가 (실제 UA)
#     - python-httpx 추가 (Burp Suite proxy 등에서 사용)
#     - python-requests 추가 (자동화 스크립트 탐지)
#     17개 → 21개
# ─────────────────────────────────────────────────────────────────────────
alert tcp any any -> any 5000 (msg:"[INFO] Security Scanner Activity Detected"; \
    http_header; pcre:"/User-Agent:.*(sqlmap|Nikto|Nmap|DirBuster|zgrab|masscan|gobuster|wfuzz|nuclei|ffuf|Fuzz Faster U Fool|Hydra|Arachni|OpenVAS|w3af|skipfish|WhatWeb|WPScan|python-httpx|python-requests|curl\/|libwww-perl)/i"; \
    sid:1000004; rev:7;)
